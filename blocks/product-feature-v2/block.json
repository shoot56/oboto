{
  "name": "oboto/product-feature-v2",
  "title": "Product Feature V2",
  "description": "Two-column product feature with an optional section heading, configurable media position, rich feature rows, and an accent-colored CTA.",
  "category": "obot_landing",
  "icon": "columns",
  "keywords": ["product", "feature", "media", "video", "html"],
  "acf": {
    "mode": "preview",
    "renderTemplate": "block-render.php"
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  },
  "supports": {
    "align": true,
    "anchor": true,
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "background": true,
      "gradients": true,
      "link": true
    },
    "dimensions": {
      "minHeight": true
    }
  },
  "style": ["product-feature-v2"],
  "viewScript": ["product-feature-v2-script"]
}
