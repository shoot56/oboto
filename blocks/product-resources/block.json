{
  "name": "oboto/product-resources",
  "title": "Product Resources",
  "description": "Product resources section with eyebrow, title, and resource cards.",
  "category": "obot_landing",
  "icon": "screenoptions",
  "keywords": ["product", "resources", "cards", "links"],
  "acf": {
    "mode": "preview",
    "blockVersion": 3,
    "renderTemplate": "block-render.php"
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  },
  "supports": {
    "align": true,
    "anchor": true,
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "background": true,
      "gradients": true,
      "link": true
    },
    "dimensions": {
      "minHeight": true
    },
    "position": {
      "sticky": true
    }
  },
  "style": ["product-resources"]
}
