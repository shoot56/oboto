{
  "name": "oboto/landing-hero",
  "title": "Landing Hero",
  "description": "Obot landing page hero with decorative MCP network and content.",
  "category": "obot_landing",
  "icon": "cover-image",
  "keywords": ["landing", "hero", "mcp"],
  "acf": {
    "mode": "preview",
    "blockVersion": 3,
    "renderTemplate": "block-render.php"
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  },
  "supports": {
    "align": true,
    "anchor": true,
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "background": true,
      "gradients": true,
      "link": true
    },
    "dimensions": {
      "minHeight": true
    },
    "position": {
      "sticky": true
    }
  },
  "style": ["landing-hero"],
  "viewScript": ["landing-hero-script"]
}
