{
  "name": "oboto/comparison-hero",
  "title": "Comparison Hero",
  "description": "Comparison page hero with an eyebrow and title.",
  "category": "obot_landing",
  "icon": "cover-image",
  "keywords": ["comparison", "hero", "eyebrow", "title"],
  "acf": {
    "mode": "preview",
    "blockVersion": 3,
    "renderTemplate": "block-render.php"
  },
  "attributes": {
